generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Shop {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  logo           String?
  primaryColor   String?
  secondaryColor String?
  address        String?
  phone          String?
  email          String?
  createdAt      DateTime @default(now())

  users     User[]
  employees Employee[]
  services  Service[]
  bookings  Booking[]
  gallery   GalleryImage[]
  offers    Offer[]
}

model User {
  id       Int    @id @default(autoincrement())
  shopId   Int
  name     String
  email    String @unique
  password String
  role     Role

  shop     Shop      @relation(fields: [shopId], references: [id])
  employee Employee?
}

model Employee {
  id       Int     @id @default(autoincrement())
  shopId   Int
  userId   Int?    @unique
  name     String
  bio      String?
  avatar   String?
  isActive Boolean @default(true)

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  services EmployeeService[]
  bookings Booking[]
  working  WorkingHour[]
  blocked  BlockedTime[]
}

model Service {
  id              Int     @id @default(autoincrement())
  shopId          Int
  name            String
  description     String? @db.Text
  durationMinutes Int?
  price           Float?
  isActive        Boolean @default(true)

  shop      Shop              @relation(fields: [shopId], references: [id])
  employees EmployeeService[]
  bookings  Booking[]
}

model EmployeeService {
  id              Int     @id @default(autoincrement())
  employeeId      Int
  serviceId       Int
  durationMinutes Int
  price           Float
  isActive        Boolean @default(true)

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
}

model Booking {
  id         Int @id @default(autoincrement())
  shopId     Int
  employeeId Int
  serviceId  Int

  customerName  String
  customerPhone String
  customerEmail String?

  bookingDate DateTime
  startTime   DateTime
  endTime     DateTime

  durationSnapshot Int
  priceSnapshot    Float

  status BookingStatus @default(CONFIRMED)
  notes  String?

  createdAt DateTime @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
}

model WorkingHour {
  id         Int     @id @default(autoincrement())
  employeeId Int
  dayOfWeek  Int
  startTime  String
  endTime    String
  isOff      Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id])
}

model BlockedTime {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  startTime  String
  endTime    String
  reason     String?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model GalleryImage {
  id        Int     @id @default(autoincrement())
  shopId    Int
  imageUrl  String
  description String? @db.Text
  isVisible Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id])
}

model Offer {
  id          Int     @id @default(autoincrement())
  shopId      Int
  title       String
  description String?
  price       Float?
  avatar      String?
  isActive    Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id])
}

enum Role {
  shop_admin
  employee
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
